# =============================================================================
# FinSkillsTracer v5.3 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.sample .env
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider — choose one: deepseek | efund | openai | custom
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek

# ---------------------------------------------------------------------------
# DeepSeek — https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------------------------------------------------------------------------
# EFund (易方达) — https://aigc.efunds.com.cn/v1
# ---------------------------------------------------------------------------
EFUNDS_BASE_URL=https://aigc.efunds.com.cn/v1
EFUNDS_API_KEY=your_efund_api_key_here
EFUNDS_USER=SX-your_username

# ---------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# Custom (OpenAI-compatible) — Ollama, vLLM, local models, etc.
# ---------------------------------------------------------------------------
# CUSTOM_BASE_URL=https://api.openai.com/v1
# CUSTOM_API_KEY=your_custom_api_key_here
# CUSTOM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Financial Data APIs (v5.3 — optional but recommended)
# ---------------------------------------------------------------------------
# Alpha Vantage free tier: 5 calls/min. Get key at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# SerpAPI free tier: 100 searches/month. Get key at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here
